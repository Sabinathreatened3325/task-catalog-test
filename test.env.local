# TEMPLATE FILE ONLY.
# Do not put real secrets or real environment values into test.env.local.
# Create a separate real file named .env.local without the test. prefix.
# Copy these keys into .env.local and replace every test value with your own real value.
# This test.env.local file stays in the repository only as a safe example.

# HTTP port for the local application process.
APP_PORT=8080

# JDBC URL for your local database.
# Default template uses in-memory H2 for quick local start.
APP_DATASOURCE_URL=jdbc:h2:mem:task_catalog;MODE=PostgreSQL;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE

# Local database username.
APP_DATASOURCE_USERNAME=test_local_user

# Local database password.
APP_DATASOURCE_PASSWORD=test_local_password

# JDBC driver class used by the local datasource.
APP_DATASOURCE_DRIVER_CLASS_NAME=org.h2.Driver
