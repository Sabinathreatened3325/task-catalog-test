# TEMPLATE FILE ONLY.
# Do not put real secrets or real environment values into test.env.repository.
# Create a separate real file named .env.repository without the test. prefix.
# Copy these keys into .env.repository and replace every test value with your own real value.
# This test.env.repository file stays in the repository only as a safe example.

# Git remote name used in local scripts.
GIT_REMOTE_NAME=origin

# Target repository URL for push, clone, or deploy automation.
REPOSITORY_URL=https://github.com/DokPlay/task-catalog-test.git

# Primary branch used for delivery.
REPOSITORY_BRANCH=main

# GitHub username for HTTPS-based automation only.
GITHUB_USERNAME=test_github_user

# GitHub token for HTTPS-based automation only.
# Do not store a real token in repository-tracked files.
GITHUB_TOKEN=test_github_token
