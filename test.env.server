# TEMPLATE FILE ONLY.
# Do not put real secrets or real environment values into test.env.server.
# Create a separate real file named .env.server without the test. prefix.
# Copy these keys into .env.server and replace every test value with your own real value.
# This test.env.server file stays in the repository only as a safe example.

# Server hostname or IP used for SSH access.
SERVER_HOST=example.server.test

# SSH port of the target server.
SERVER_PORT=22

# SSH user used for deployment.
SERVER_USER=deploy

# Absolute path on the server where the project or release should live.
DEPLOY_PATH=/opt/task-catalog

# Repository URL that the server or deploy script should pull from.
REPOSITORY_URL=https://github.com/DokPlay/task-catalog-test.git

# Default branch to deploy from.
REPOSITORY_BRANCH=main

# HTTP port for the application on the server.
APP_PORT=8080

# JDBC URL for the server database.
# Template points to local PostgreSQL on the server host.
APP_DATASOURCE_URL=jdbc:postgresql://localhost:5432/task_catalog

# Database username for the server runtime.
APP_DATASOURCE_USERNAME=test_server_user

# Database password for the server runtime.
APP_DATASOURCE_PASSWORD=test_server_password

# JDBC driver class for PostgreSQL.
APP_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
